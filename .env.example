# ==============================================================================
# ALAMAT WEB BFF NEXT.JS (Port 3000) - Pilih salah satu dan sesuaikan
# ==============================================================================

# OPSI 1: Local Browser / Web Preview (Expo Web)
EXPO_PUBLIC_BFF_URL=http://localhost:3000

# OPSI 2: Android Studio Emulator (10.0.2.2 mengarah ke host laptop)
# EXPO_PUBLIC_BFF_URL=http://10.0.2.2:3000

# OPSI 3: HP Fisik via WiFi LAN (Satu jaringan WiFi dengan laptop)
# EXPO_PUBLIC_BFF_URL=http://<IP_LAN_LAPTOP>:3000

# OPSI 4: VPS Kampus (Ganti <IP_VPS_KAMPUS> dengan IP server kampus)
# EXPO_PUBLIC_BFF_URL=http://<IP_VPS_KAMPUS>:3000
# Atau jika menggunakan domain & HTTPS:
# EXPO_PUBLIC_BFF_URL=https://<DOMAIN_BFF_KAMPUS>


# ==============================================================================
# ALAMAT WEBSOCKET CORE BACKEND (Port 8000) - Pilih salah satu dan sesuaikan
# ==============================================================================

# OPSI 1: Local Web Preview
EXPO_PUBLIC_WS_URL=ws://localhost:8000/ws

# OPSI 2: Android Studio Emulator
# EXPO_PUBLIC_WS_URL=ws://10.0.2.2:8000/ws

# OPSI 3: HP Fisik via WiFi LAN
# EXPO_PUBLIC_WS_URL=ws://<IP_LAN_LAPTOP>:8000/ws

# OPSI 4: VPS Kampus (Ganti <IP_VPS_KAMPUS> dengan IP server kampus)
# EXPO_PUBLIC_WS_URL=ws://<IP_VPS_KAMPUS>:8000/ws
# Atau jika menggunakan domain & WSS (SSL):
# EXPO_PUBLIC_WS_URL=wss://<DOMAIN_API_KAMPUS>/ws
